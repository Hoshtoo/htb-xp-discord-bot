# Required — Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Required for /link, /mog, and own notifications — HTB app token (see README)
HTB_TOKEN=

# SQLite database path (created automatically)
DATABASE_PATH=./data/bot.db

# Optional — register slash commands to one guild instantly (recommended for development)
# GUILD_ID=

# Optional — Discord test server for npm run showcase:discord (see docs/SHOWCASE_DISCORD.md)
# TEST_GUILD_ID=
# TEST_CHANNEL_ID=

# Optional — Playwright browser channel (default: chrome)
# PW_CHANNEL=chrome

# Optional — use a system browser instead (e.g. Raspberry Pi: /usr/bin/chromium)
# PW_EXECUTABLE_PATH=

# Optional — how often (ms) to poll HTB for new owns to announce (default 1200000 = 20 min)
# NOTIFY_POLL_INTERVAL_MS=1200000
