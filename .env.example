# Required — Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Required for /link only — HTB app token (see README)
HTB_TOKEN=

# SQLite database path (created automatically)
DATABASE_PATH=./data/bot.db

# Optional — register slash commands to one guild instantly (recommended for development)
# GUILD_ID=

# Optional — Playwright browser channel (default: chrome)
# PW_CHANNEL=chrome

# Optional — use a system browser instead (e.g. Raspberry Pi: /usr/bin/chromium)
# PW_EXECUTABLE_PATH=
